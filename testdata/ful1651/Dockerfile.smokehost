FROM golang:1.27 AS build
WORKDIR /src
COPY . .

# THE HARNESS PACKAGE IS ASSEMBLED HERE RATHER THAN CHECKED IN, so no command
# lands in the shipped raft module. It is three sources plus one generated file:
# the harness itself, the recovery fixture's node bodies, and the .flow the
# SHIPPED flowc turns into a Wire function.
WORKDIR /src/raft
RUN mkdir -p cmd/smokehost \
 && cp /src/testdata/ful1651/smokehost.go.txt cmd/smokehost/main.go \
 && cp /src/testdata/ful1651/recovery/feed.go cmd/smokehost/feed.go \
 && cp /src/testdata/ful1651/recovery/recover.flow cmd/smokehost/recover.flow

# GENERATED BY THE SHIPPED BINARY, not by a probe driver. Step 4.4's observation
# is about the landed recovery code carrying a REAL flow's datum across a pod
# deletion, so the flow that runs in the pod is the one flowc generates, on the
# same path steps 3.1 through 3.5 drove on the host.
WORKDIR /src/lang/assembler
RUN CGO_ENABLED=0 go build -o /out/flowc ./cmd/flowc
WORKDIR /src/raft/cmd/smokehost
RUN /out/flowc -in . -out . -package main -qualifier smokehost

WORKDIR /src/raft
RUN CGO_ENABLED=0 GOOS=linux go build -o /out/smokehost ./cmd/smokehost

FROM gcr.io/distroless/static-debian12
COPY --from=build /out/smokehost /smokehost
ENTRYPOINT ["/smokehost"]
