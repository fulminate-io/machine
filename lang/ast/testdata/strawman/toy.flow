flow orders
note """
Order intake: validate, charge billables, retry flaky charges, archive rejects.
"""
import "github.com/acme/billing"
import "acme.dev/flows/audit"
state {
  charged int
}
var attempt int
on error audit.Alert
source ingest http.Listen[Order](":8080")
branch validate billing.Validate from ingest -> billable, rejected
transform charge billing.Charge from billable
  reads attempt  writes charged
  over pubsub.Topic("charges")
  on error billing.Refund
  note """idempotent: broker may redeliver during failover"""
branch settle billing.Settled from charge -> settled, flaky
tee split from settled -> ledger, mirror
transform archive audit.Store from rejected, mirror
drop ledger
loop retry
send flaky -> retry
transform redo billing.Backoff from retry
  reads attempt  writes attempt
send redo -> charge
